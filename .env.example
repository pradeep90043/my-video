# ── LLM Provider (gemini | claude) ───────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ── Image Generation ──────────────────────────────────────────────────────────
IMAGE_MODEL=gemini-2.0-flash-preview-image-generation

# ── Voice Provider (openai-fm | google-tts | edge-tts | mac-tts) ─────────────
# openai-fm  = most natural, free (uses Puppeteer scraping of openai.fm)
# google-tts = very natural, free 1M chars/month (requires API key)
# edge-tts   = decent, free, no key needed
VOICE_PROVIDER=google-tts

# Google Cloud TTS (free: 1M chars/month, great for Hinglish)
GOOGLE_TTS_KEY=
GOOGLE_TTS_LANGUAGE=hi-IN
GOOGLE_TTS_VOICE=hi-IN-Neural2-A
GOOGLE_TTS_SPEED=1.0
GOOGLE_TTS_PITCH=0

# ── Branding ──────────────────────────────────────────────────────────────────
# Path to the outro clip appended to every video
OUTRO_PATH=/Users/apple/Documents/end-video-no-watermark.mp4

# ── Instagram API Configuration ───────────────────────────────────────────────
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=storiyum_verify_token
PUBLIC_TUNNEL_URL=
STORY_FULL_LINK=

# ── YouTube API Configuration ───────────────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback
YOUTUBE_REFRESH_TOKEN=


