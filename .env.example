# ── LLM Provider (gemini | claude) ───────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ── Image Generation ──────────────────────────────────────────────────────────
IMAGE_MODEL=gemini-2.0-flash-preview-image-generation

# ── Voice Provider (elevenlabs | google-tts) ──────────────────────────────────
VOICE_PROVIDER=elevenlabs

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Google Cloud TTS (free: 1M chars/month, great for Hinglish)
GOOGLE_TTS_KEY=
GOOGLE_TTS_LANGUAGE=hi-IN
GOOGLE_TTS_VOICE=hi-IN-Neural2-A
GOOGLE_TTS_SPEED=1.0
GOOGLE_TTS_PITCH=0

# ── Branding ──────────────────────────────────────────────────────────────────
# Path to the outro clip appended to every video
OUTRO_PATH=/Users/apple/Documents/end-video-no-watermark.mp4
