{
  "name": "2-Day Quality Cycle — All Channels",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 9 * * *" }
          ]
        }
      },
      "id": "trigger-codeorcap",
      "name": "CodeOrCap — 9am Daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [100, 100]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 14 * * *" }
          ]
        }
      },
      "id": "trigger-storiyum",
      "name": "Storiyum — 2pm Daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [100, 250]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 18 * * *" }
          ]
        }
      },
      "id": "trigger-infoonspot",
      "name": "InfoOnSpot — 6pm Daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [100, 400]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 21 * * *" }
          ]
        }
      },
      "id": "trigger-promptgag",
      "name": "PromptGag — 9pm Daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [100, 550]
    },

    {
      "parameters": {
        "method": "GET",
        "url": "=http://host.docker.internal:3001/api/topic-state/codeorcap",
        "options": { "timeout": 10000 }
      },
      "id": "state-codeorcap",
      "name": "Get CodeOrCap State",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [320, 100]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://host.docker.internal:3001/api/topic-state/storiyum",
        "options": { "timeout": 10000 }
      },
      "id": "state-storiyum",
      "name": "Get Storiyum State",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [320, 250]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://host.docker.internal:3001/api/topic-state/infoonspot",
        "options": { "timeout": 10000 }
      },
      "id": "state-infoonspot",
      "name": "Get InfoOnSpot State",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [320, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://host.docker.internal:3001/api/topic-state/promptgag",
        "options": { "timeout": 10000 }
      },
      "id": "state-promptgag",
      "name": "Get PromptGag State",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [320, 550]
    },

    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3001/api/generate/sync",
        "sendBody": true,
        "contentType": "json",
        "body": "={ \"channel\": \"codeorcap\", \"publishMode\": \"{{ $json.nextMode }}\" }",
        "options": {
          "timeout": 1800000,
          "response": { "response": { "responseFormat": "json" } }
        }
      },
      "id": "generate-codeorcap",
      "name": "Generate CodeOrCap Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3001/api/generate/sync",
        "sendBody": true,
        "contentType": "json",
        "body": "={ \"channel\": \"storiyum\", \"publishMode\": \"{{ $json.nextMode }}\" }",
        "options": {
          "timeout": 1800000,
          "response": { "response": { "responseFormat": "json" } }
        }
      },
      "id": "generate-storiyum",
      "name": "Generate Storiyum Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 250]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3001/api/generate/sync",
        "sendBody": true,
        "contentType": "json",
        "body": "={ \"channel\": \"infoonspot\", \"publishMode\": \"{{ $json.nextMode }}\" }",
        "options": {
          "timeout": 1800000,
          "response": { "response": { "responseFormat": "json" } }
        }
      },
      "id": "generate-infoonspot",
      "name": "Generate InfoOnSpot Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3001/api/generate/sync",
        "sendBody": true,
        "contentType": "json",
        "body": "={ \"channel\": \"promptgag\", \"publishMode\": \"{{ $json.nextMode }}\" }",
        "options": {
          "timeout": 1800000,
          "response": { "response": { "responseFormat": "json" } }
        }
      },
      "id": "generate-promptgag",
      "name": "Generate PromptGag Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 550]
    },

    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-codeorcap",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-codeorcap",
      "name": "CodeOrCap Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [800, 100]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-storiyum",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-storiyum",
      "name": "Storiyum Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [800, 250]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-infoonspot",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-infoonspot",
      "name": "InfoOnSpot Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [800, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-promptgag",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-promptgag",
      "name": "PromptGag Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [800, 550]
    },

    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "notify-success",
              "name": "message",
              "value": "=✅ {{ $json.result.channel.toUpperCase() }} | {{ $json.result.publishMode === 'day1-long' ? '🎬 Day 1 Long-form' : '📱 Day 2 Short' }} published!\n\nTitle: {{ $json.result.title }}\nSlug: {{ $json.result.slug }}\nDuration: {{ $json.result.duration }}s\n{{ $json.result.publishMode === 'day2-short' ? '🔗 Linked to: ' + $json.result.linkedVideoUrl : '' }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "notify-success",
      "name": "Format Success Notification",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "notify-error",
              "name": "message",
              "value": "=❌ Video generation FAILED!\n\nChannel: {{ $json.channel }}\nError: {{ $json.error }}\n\nLogs:\n{{ $json.logs ? $json.logs.join('\\n') : 'No logs' }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "notify-error",
      "name": "Format Error Notification",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1050, 450]
    }
  ],
  "connections": {
    "CodeOrCap — 9am Daily":   { "main": [[{ "node": "Get CodeOrCap State",   "type": "main", "index": 0 }]] },
    "Storiyum — 2pm Daily":    { "main": [[{ "node": "Get Storiyum State",    "type": "main", "index": 0 }]] },
    "InfoOnSpot — 6pm Daily":  { "main": [[{ "node": "Get InfoOnSpot State",  "type": "main", "index": 0 }]] },
    "PromptGag — 9pm Daily":   { "main": [[{ "node": "Get PromptGag State",   "type": "main", "index": 0 }]] },

    "Get CodeOrCap State":  { "main": [[{ "node": "Generate CodeOrCap Video",  "type": "main", "index": 0 }]] },
    "Get Storiyum State":   { "main": [[{ "node": "Generate Storiyum Video",   "type": "main", "index": 0 }]] },
    "Get InfoOnSpot State": { "main": [[{ "node": "Generate InfoOnSpot Video", "type": "main", "index": 0 }]] },
    "Get PromptGag State":  { "main": [[{ "node": "Generate PromptGag Video",  "type": "main", "index": 0 }]] },

    "Generate CodeOrCap Video":  { "main": [[{ "node": "CodeOrCap Success?",  "type": "main", "index": 0 }]] },
    "Generate Storiyum Video":   { "main": [[{ "node": "Storiyum Success?",   "type": "main", "index": 0 }]] },
    "Generate InfoOnSpot Video": { "main": [[{ "node": "InfoOnSpot Success?", "type": "main", "index": 0 }]] },
    "Generate PromptGag Video":  { "main": [[{ "node": "PromptGag Success?",  "type": "main", "index": 0 }]] },

    "CodeOrCap Success?":  { "main": [[{ "node": "Format Success Notification", "type": "main", "index": 0 }], [{ "node": "Format Error Notification", "type": "main", "index": 0 }]] },
    "Storiyum Success?":   { "main": [[{ "node": "Format Success Notification", "type": "main", "index": 0 }], [{ "node": "Format Error Notification", "type": "main", "index": 0 }]] },
    "InfoOnSpot Success?": { "main": [[{ "node": "Format Success Notification", "type": "main", "index": 0 }], [{ "node": "Format Error Notification", "type": "main", "index": 0 }]] },
    "PromptGag Success?":  { "main": [[{ "node": "Format Success Notification", "type": "main", "index": 0 }], [{ "node": "Format Error Notification", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  },
  "id": "two-day-quality-cycle-v2",
  "meta": {
    "instanceId": "codeorcap-local",
    "description": "2-day quality-first publishing cycle. Day 1 = 10-min long-form. Day 2 = Short with clickable link to Day 1. All 4 channels run independently at staggered times."
  }
}
