 "totalFrames": 12985,
 "scenes": [
  {
   "id": "s00",
   "text": "आज इंडिया के सबसे अमीर परिवारों में से एक है अंबानी परिवार।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 0,
   "durationFrames": 173,
   "duration": 5.766666666666667
  },
  {
   "id": "s01",
   "text": "पेट्रोल, फोन, कपड़े, ग्रोसरी।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 173,
   "durationFrames": 102,
   "duration": 3.4
  },
  {
   "id": "s02",
   "text": "आप दिन में किसी ना किसी तरह Reliance का पैसा जरूर खर्च करते हैं।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 275,
   "durationFrames": 184,
   "duration": 6.133333333333334
  },
  {
   "id": "s03",
   "text": "लेकिन क्या आप जानते हैं इस सारी दौलत की शुरुआत एक ऐसे लड़के से हुई थी जिसके पिता स्कूल टीचर थे जो कभी तीर्थ यात्रियों को पकोड़े बेचता था।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 459,
   "durationFrames": 361,
   "duration": 12.033333333333333
  },
  {
   "id": "s04",
   "text": "यह कहानी सिर्फ अमीरी की नहीं है।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 820,
   "durationFrames": 122,
   "duration": 4.066666666666666
  },
  {
   "id": "s05",
   "text": "यह कहानी है एक बड़ी सोच, रिस्क और एक जबरदस्त स्ट्रेटजी की।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 942,
   "durationFrames": 187,
   "duration": 6.233333333333333
  },
  {
   "id": "s06",
   "text": "आज हम समझेंगे कि अंबानी इतने अमीर कैसे बने।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 1129,
   "durationFrames": 148,
   "duration": 4.933333333333334
  },
  {
   "id": "s07",
   "text": "धीरूभाई अंबानी का जन्म 1932 में गुजरात के चोरवाड़ गांव में हुआ।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 1277,
   "durationFrames": 202,
   "duration": 6.733333333333333
  },
  {
   "id": "s08",
   "text": "परिवार बहुत अमीर नहीं था।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 1479,
   "durationFrames": 95,
   "duration": 3.1666666666666665
  },
  {
   "id": "s09",
   "text": "पिता स्कूल में पढ़ाते थे और घर की हालत ठीक-ठाक ही थी।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 1574,
   "durationFrames": 166,
   "duration": 5.533333333333333
  },
  {
   "id": "s10",
   "text": "कहा जाता है कि धीरूभाई ने बचपन में ही पैसे कमाने की कोशिश शुरू कर दी थी।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 1740,
   "durationFrames": 198,
   "duration": 6.6
  },
  {
   "id": "s11",
   "text": "एक कहानी यह मशहूर है कि वह गिरनार के मेले में आने वाले लोगों को पकोड़े बेचते थे।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 1938,
   "durationFrames": 221,
   "duration": 7.366666666666666
  },
  {
   "id": "s12",
   "text": "सिर्फ 16 17 साल की उम्र में वह यमन के अदन शहर पहुंच गए।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 2159,
   "durationFrames": 178,
   "duration": 5.933333333333334
  },
  {
   "id": "s13",
   "text": "वहां एक ट्रेडिंग कंपनी में नौकरी की।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 2337,
   "durationFrames": 119,
   "duration": 3.966666666666667
  },
  {
   "id": "s14",
   "text": "काम छोटा था।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 2456,
   "durationFrames": 70,
   "duration": 2.3333333333333335
  },
  {
   "id": "s15",
   "text": "तनख्वाह भी ज्यादा नहीं थी।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 2526,
   "durationFrames": 94,
   "duration": 3.1333333333333333
  },
  {
   "id": "s16",
   "text": "लेकिन यहां उन्होंने वह चीज सीखी जो बाद में उनकी सबसे बड़ी ताकत बनी।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 2620,
   "durationFrames": 195,
   "duration": 6.5
  },
  {
   "id": "s17",
   "text": "ट्रेडिंग कैसे होती है?",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 2815,
   "durationFrames": 93,
   "duration": 3.1
  },
  {
   "id": "s18",
   "text": "मार्जिन कैसे बनता है?",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 2908,
   "durationFrames": 99,
   "duration": 3.3
  },
  {
   "id": "s19",
   "text": "और दुनिया में चीजें कहां सस्ती और कहां महंगी बिकती हैं?",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 3007,
   "durationFrames": 167,
   "duration": 5.566666666666666
  },
  {
   "id": "s20",
   "text": "कुछ साल बाद 1958 के आसपास वो इंडिया वापस आए।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 3174,
   "durationFrames": 176,
   "duration": 5.866666666666666
  },
  {
   "id": "s21",
   "text": "जेब में बहुत कम पैसा था लेकिन दिमाग में एक पक्का आईडिया था।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 3350,
   "durationFrames": 177,
   "duration": 5.9
  },
  {
   "id": "s22",
   "text": "मुंबई के मस्जिद बंदर में एक छोटा सा कमरा, एक फोन और कुछ कुर्सियां।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 3527,
   "durationFrames": 190,
   "duration": 6.333333333333333
  },
  {
   "id": "s23",
   "text": "यहीं से Reliance कमर्शियल कॉरपोरेशन की शुरुआत हुई।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 3717,
   "durationFrames": 146,
   "duration": 4.866666666666666
  },
  {
   "id": "s24",
   "text": "शुरू में वो मसाले और दूसरी चीजें एक्सपोर्ट करते थे।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 3863,
   "durationFrames": 156,
   "duration": 5.2
  },
  {
   "id": "s25",
   "text": "और यर्न यानी धागा इंपोर्ट करते थे।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 4019,
   "durationFrames": 119,
   "duration": 3.966666666666667
  },
  {
   "id": "s26",
   "text": "फिर उन्होंने एक समझदारी भरा फैसला किया।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 4138,
   "durationFrames": 128,
   "duration": 4.266666666666667
  },
  {
   "id": "s27",
   "text": "उस वक्त इंडिया में पॉलीएस्टर धागे की डिमांड बढ़ रही थी और धीरू भाई ने इसमें बड़ा मौका देखा।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 4266,
   "durationFrames": 241,
   "duration": 8.033333333333333
  },
  {
   "id": "s28",
   "text": "उनकी सोच सिंपल थी।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 4507,
   "durationFrames": 87,
   "duration": 2.9
  },
  {
   "id": "s29",
   "text": "कम मार्जिन लो लेकिन बहुत ज्यादा माल बेचो।",
   "visual": {
    "pose": "idle"
   },
   "startFrame": 4594,
   "durationFrames": 124,
   "duration": 4.133333333333334
  },
  {
   "id": "s30",
   "text": "जब तक दूसरे कपड़ा बिजनेसमैन सोचते रहते।",
