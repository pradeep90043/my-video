    "pose": "idle"
   },
   "startFrame": 645,
   "durationFrames": 211,
   "duration": 7.033333333333333
  },
  {
   "id": "s05",
   "text": "हमारी गायों को घास तो गोवर्धन पर्वत देता है।",
